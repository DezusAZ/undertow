# vpntorrent configuration. Copy this to ".env" (the installer does it for you)
# and edit the values. docker compose loads ".env" from this folder automatically.

# Where downloads + your media library live ON THIS MACHINE. The installer creates it.
# Point this at whatever drive has the space, e.g. /media/<drive>/undertow
MEDIA_PATH=/media/storage/undertow

# Web login password — CHANGE THIS.
VT_PASSWORD=changeme

# Optional: a free TMDB API key adds poster art + descriptions in the Library tab.
# Get one at https://www.themoviedb.org/settings/api . Leave blank to skip.
TMDB_API_KEY=

# Timezone (affects logs + scan timestamps).
TZ=America/Phoenix

# Host port for the web UI (http://<host>:<WEB_PORT>).
WEB_PORT=8722

# IP or hostname used for the dashboard tile link (your LAN IP or Tailscale IP).
# The installer auto-detects this; override if needed.
HOST_IP=127.0.0.1

# Internal network for the decoder sandbox. The installer auto-picks a free range
# if the default collides with an existing Docker network on the target. Must be
# inside 172.16.0.0/12; the two IPs must be inside the subnet and different.
SANDBOX_SUBNET=172.24.9.0/24
TRANSCODER_IP=172.24.9.2
VPNTORRENT_SANDBOX_IP=172.24.9.3

# Absolute path to THIS project directory. The watchdog sidecar bind-mounts the project
# at the identical path inside and out so `docker compose` resolves ./config correctly.
# Leave unset to use the directory you run compose from.
UNDERTOW_DIR=

# Optional: local Ollama server for the Deep Hunt LLM + result explanations.
# Leave BLANK unless you actually run one — nothing else depends on it.
OLLAMA_URL=

# Optional: hostname the ZimaOS/CasaOS dashboard tile should open (LAN IP, Tailscale
# MagicDNS name, ...). Leave blank if you don't use a dashboard tile.
CASAOS_HOSTNAME=

# ---- Usenet (all optional; leave blank to use torrents only) ----
NEWZNAB_URL=
NZBGEEK_APIKEY=
SAB_URL=http://127.0.0.1:8085
SAB_APIKEY=

# Origins allowed to submit forms/POSTs (CSRF protection). Add your front-door URL if
# you reach Undertow through a reverse proxy on a different port, e.g.
# TRUSTED_ORIGINS=https://mybox.tailnet.ts.net:8723
# The address you browse to directly is accepted automatically.
TRUSTED_ORIGINS=
